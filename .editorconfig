root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4
csharp_style_namespace_declarations = file_scoped:warning

[src/Sudoku.Api/Data/Migrations/*.cs]
csharp_style_namespace_declarations = block_scoped:silent

[*.{ts,vue,json,css,html}]
indent_size = 2
